# API Gateway (prefix /api/v1 khai báo trong api-gateway/application.yaml)
VITE_API_BASE_URL=http://localhost:8888/api/v1

# Tuỳ chọn: đăng nhập Google (identity-service /auth/outbound/identity)
# redirect uri phải trùng với outbound.identity.redirect-uri của identity-service
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/authenticate
